  "claims": [
    {
      "id": "claim_677ada1ad8954e7ab10c0fb91630d38d",
      "statement": "NEPO uses Drizzle ORM (postgres.js driver) against PostgreSQL with the schema in a single ~1300-line file backend/src/db/schema.ts and migrations under backend/src/db/migrations; all status/type fields use pgEnum declarations at the top of schema.ts (lines 23-48) covering trip_status, fuel_mode, loading_type, role, txn_type, trailer_type, truck/trailer/driver/customer status, penalty_status, vehicle_component, vehicle_schedule kind/status, advance_request/settlement status, notification_type, work_day_status, and salary_confirmation_status.",
      "evidence": [
        {
          "resource": "repo://backend/drizzle.config.ts",
          "version": "repo-file-v1:sha256:b03cdf885464bef6d10a7e5aa72100fb33ee5e09714da0c64bdf7bae3a472e69"
        },
        {
          "resource": "repo://backend/src/db/schema.ts#L2-L48",
          "version": "repo-lines-v1:sha256:c6f5de5bdd3e725d6ff130edc7f0f043d89bf3bf36b18c95bfc82593341fb3b5:"
        }
      ]
    },
    {
      "id": "claim_fc58fdd1581e41e89e534057dededc15",
      "statement": "The ledger table (schema.ts:405) implements the project's loosely-coupled entity reference convention: entityType is a varchar(50) string (one of DRIVER/CLIENT/VENDOR/FORWARDER/...) and entityId is an integer — both deliberately without foreign keys so the ledger outlives the entity; balance is numeric(15, 0) for exact VND precision.",
      "evidence": [
        {
          "resource": "repo://backend/src/db/schema.ts#L405-L426",
          "version": "repo-lines-v1:sha256:567fb32dd756d8ea3eea39af7bf7e980df24c0c0b8624145950c41137c38490a:"
        }
      ]
    },
    {
      "id": "claim_6304892109fe403ca67e1c49b6d23193",
      "statement": "The ledger table has hot-path indexes (entity, entity+id, entity+txn_type+timestamp) and a partial unique index that enforces FORWARDER_SETTLEMENT idempotence only for that txn type using WHERE sql predicates.",
      "evidence": [
        {
          "resource": "repo://backend/src/db/schema.ts#L418-L425",
          "version": "repo-lines-v1:sha256:7743c5f486b56fa5d4e4dea102eeb1d3ae156a52fefbfa17c937badc42dda6ff:"
        }
      ]
    },
    {
      "id": "claim_6ed98109de184de0944cc9710df96ef8",
      "statement": "Tables group into users/roles, fleet (trucks/trailers/tires/tire_positions/vehicle_schedules), catalogs (customers/routes/cargo_types/pricing_tables/road_allowances/fuel_config/fuel_price_history/penalty_reasons/company_info/management_fees/road_config/app_settings), suppliers/expenses, trips and legs/containers/expenses/photos, forwarder flow, ledger+receivables+billing+debit_note_templates, distribution+salary, audit+infra, GPS, agent/chatbot, and notifications.",
      "evidence": [
        {
          "resource": "repo://backend/src/db/schema.ts#L51-L1299",
          "version": "repo-lines-v1:sha256:e69c5094925b6b2719d6a2ff70c15a498f8398430b294dec087c268c34326926:"
        }
