    {
      "id": "claim_8617b351cd144af68b21e35124ba7331",
      "statement": "Migrations are generated with pnpm db:generate / make generate (drizzle-kit generate diffs schema.ts into a new file under backend/drizzle/), applied with pnpm db:migrate / make migrate (drizzle-kit migrate follows meta/_journal.json), inspected with pnpm db:studio / make studio, and sample data is loaded with pnpm seed / make seed. Production migrations live in backend/drizzle/ (not deploy/) and are applied with make prod-migrate, which loops over backend/drizzle/*.sql in plain filename order, excludes *.revert.sql dev-rollback pairs, and pipes each file through scp → docker cp → psql --single-transaction inside the nepocorp-postgres-1 container; make prod-migrate-file FILE=... applies a single file the same way. Container deployments (make demo-backend, backend/Makefile deploy) instead run npx drizzle-kit migrate inside the backend container.",
      "evidence": [
        {
          "resource": "repo://Makefile#L180-L198",
          "version": "repo-lines-v1:sha256:efbe9112f20b583bf250b892bbf52397a1bf28c4c8986674a8698cb58c628527:"
