    {
      "id": "claim_50c5b3b508214756b98fd203dc7102c4",
      "statement": "The prod-migrate target applies every backend/drizzle/*.sql file except *.revert.sql (dev-rollback pairs must never run against prod): it SCPs each file to root@nepo.tingting.vip:/tmp, docker cps it into nepocorp-postgres-1, and runs psql -U nepocorp -d nepocorp -v ON_ERROR_STOP=1 --single-transaction so a partial migration rolls back cleanly; a failing file is reported as 'skipped (already applied)' so reruns are safe (migration SQL must be idempotent), the /tmp copy is removed regardless of outcome, and the target ends by restarting nepocorp-backend-1 so the running backend picks up the new schema.",
      "evidence": [
        {
          "resource": "repo://Makefile#L180-L198",
          "version": "repo-lines-v1:sha256:efbe9112f20b583bf250b892bbf52397a1bf28c4c8986674a8698cb58c628527:"
        }
      ]
    },
