PORT=3090
DATABASE_URL=postgres://postgres:postgres@localhost:5440/tingting
REDIS_URL=redis://localhost:6390
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
UPLOAD_DIR=./uploads
NODE_ENV=development
GEMINI_API_KEY=

# Bách Khoa GPS (dvbk.vn) — live vehicle tracking. Vendor-provided; SERVER-SIDE
# ONLY. Leave empty to disable live tracking (the live-fleet endpoint degrades
# to an empty result). Use the HTTPS base — the host redirects HTTP→HTTPS.
BACH_KHOA_API_URL=https://dvbk.vn/BachKhoaAPI/
BACH_KHOA_USERNAME=
BACH_KHOA_PASSWORD=
BACH_KHOA_TIMEOUT_MS=8000
# Source: auto (try API, fall back to portal), api, or portal
BACH_KHOA_PROVIDER=auto

# Map4D place search (api.map4d.vn) — the provider the Bách Khoa portal embeds.
# Powers place autocomplete + geocoding (replaces OpenStreetMap/Nominatim).
# The key alone authenticates (?key=); results cached ~3 months in Redis.
# Leave empty to disable (search/geocoding degrade to empty).
MAP4D_API_KEY=
MAP4D_API_URL=https://api.map4d.vn

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tingting.vip

# Command-and-insight assistant (bot). OFF by default — the /api/agent routes
# return 503 and the launcher is hidden until BOT_ENABLE=true. Flip on only
# AFTER (1) the MiniMax tool-calling + JSON-mode spike passes and (2) owner
# sign-off on data exposure (customer names, balances, P&L, salaries → MiniMax).
BOT_ENABLE=false
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_TIMEOUT_MS=60000
# Hard cap on the ReAct tool-calling loop (runaway guard).
AGENT_MAX_ITERATIONS=6

