{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "zai-coding-plan/glm-5.1",
  "skills": {
    "paths": [
      "/Users/dev/.claude/skills",
      "/Users/dev/.agents/skills",
      ".claude/skills"
    ]
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": "codegraph",
      "args": ["serve", "--mcp"],
      "enabled": true
    }
  },
  "plugin": [
    "@kilocode/plugin"
  ],
  "permission": {
    "mcp": {
      "codegraph_*": "allow"
    }
  }
}
