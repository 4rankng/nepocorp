{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "code-review-graph": {
      "type": "local",
      "command": [
        "uvx",
        "code-review-graph",
        "serve",
        "--repo",
        "/Volumes/LexarSSD/projects/nepocorp"
      ]
    },
    "repowise": {
      "type": "local",
      "command": [
        "repowise",
        "mcp",
        "/Volumes/LexarSSD/projects/nepocorp",
        "--transport",
        "stdio"
      ],
      "enabled": true
    }
  }
}
