{
  "javascript.preferences.importModuleSpecifier": "non-relative",
  "javascript.preferences.importModuleSpecifierEnding": "js",
  "path-intellisense.mappings": {
    "@": "${workspaceRoot}/src",
    "@components": "${workspaceRoot}/src/components",
    "@features": "${workspaceRoot}/src/features",
    "@layouts": "${workspaceRoot}/src/layouts",
    "@services": "${workspaceRoot}/src/services",
    "@hooks": "${workspaceRoot}/src/hooks",
    "@utils": "${workspaceRoot}/src/utils",
    "@contexts": "${workspaceRoot}/src/contexts",
    "@routes": "${workspaceRoot}/src/routes",
    "@constants": "${workspaceRoot}/src/constants",
    "@types": "${workspaceRoot}/src/types",
    "@assets": "${workspaceRoot}/src/assets",
    "@shared": "${workspaceRoot}/src/shared"
  },
  "path-autocomplete.pathMappings": {
    "@": "${workspaceRoot}/src",
    "@components": "${workspaceRoot}/src/components",
    "@features": "${workspaceRoot}/src/features",
    "@layouts": "${workspaceRoot}/src/layouts",
    "@services": "${workspaceRoot}/src/services",
    "@hooks": "${workspaceRoot}/src/hooks",
    "@utils": "${workspaceRoot}/src/utils",
    "@contexts": "${workspaceRoot}/src/contexts",
    "@routes": "${workspaceRoot}/src/routes",
    "@constants": "${workspaceRoot}/src/constants",
    "@types": "${workspaceRoot}/src/types",
    "@assets": "${workspaceRoot}/src/assets",
    "@shared": "${workspaceRoot}/src/shared"
  },
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ]
}
