{
  "name": "nepocorp-demo",
  "version": "0.14",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:js": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "format:css": "prettier --write \"**/*.{css,scss}\"",
    "format:json": "prettier --write \"**/*.json\"",
    "migrate:aliases": "node scripts/migrate-aliases-enhanced.js",
    "migrate:aliases:dry": "node scripts/migrate-aliases-enhanced.js --dry-run",
    "migrate:aliases:verbose": "node scripts/migrate-aliases-enhanced.js --verbose",
    "migrate:backup": "node scripts/backup-tool.js create",
    "migrate:restore": "node scripts/backup-tool.js restore",
    "migrate:test": "node scripts/test-migration.js analyze",
    "migrate:validate": "node scripts/test-migration.js full",
    "migrate": "node scripts/migrate-workflow.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@heroicons/react": "^2.1.1",
    "@mui/icons-material": "^7.1.0",
    "@mui/lab": "^7.0.0-beta.12",
    "@mui/material": "^7.1.0",
    "@mui/x-date-pickers": "^8.4.0",
    "@types/react-datepicker": "^7.0.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "glob": "^11.0.2",
    "react": "^18.2.0",
    "react-datepicker": "^8.3.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.12.2",
    "remark-gfm": "^4.0.1",
    "uuid": "^11.1.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@mui/system": "^7.0.0",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "postcss": "^8.4.32",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.1",
    "vite": "^5.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
