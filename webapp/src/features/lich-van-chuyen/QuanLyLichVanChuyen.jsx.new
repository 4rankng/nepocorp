import React, { useState } from 'react';
import { useTheme, useMediaQuery, Box, Paper, Typography, Button, Dialog, DialogTitle, DialogContent, DialogActions, TextField, CircularProgress, Alert, Snackbar, Chip } from '@mui/material';
import { Search as SearchIcon } from '@mui/icons-material';
import { AddButton, EditButton, DeleteButton } from '@/components/ActionButtons';
import StandardTable from '@/components/StandardTable';
import { PlusIcon } from '@assets/icons/index.jsx';
import useLichVanChuyenManagement from './hooks/useLichVanChuyenManagement';
import LichVanChuyenForm from './components/LichVanChuyenForm';

// Helper to format date for display
const formatDateForDisplay = (dateStr) => {
  if (!dateStr) return '-';
  const date = new Date(dateStr);
  return date.toLocaleDateString('vi-VN');
};

// Helper to get status color
const getStatusColor = (status) => {
  switch (status) {
    case 'Hoàn thành':
      return 'success';
    case 'Đang vận chuyển':
      return 'info';
    case 'Đã hủy':
      return 'error';
    default:
      return 'default';
  }
};

const QuanLyLichVanChuyen = () => {
  const theme = useTheme();
  const isMobile = useMediaQuery(theme.breakpoints.down('md'));

  // Use the custom hook for business logic
  const {
    shipments,
    isModalOpen,
    formData,
    isLoading,
    error,
    vehicles,
    partners,
    customers,
    containerTypes,
    handleInputChange,
    handleOpenModalForAdd,
    handleOpenModalForEdit,
    handleCloseModal,
    handleSaveShipment,
    handleDeleteShipment,
  } = useLichVanChuyenManagement();

  // Local state for UI
  const [searchTerm, setSearchTerm] = useState('');
  const [deleteDialogOpen, setDeleteDialogOpen] = useState(false);
  const [shipmentToDelete, setShipmentToDelete] = useState(null);
  const [snackbar, setSnackbar] = useState({
    open: false,
    message: '',
    severity: 'success',
  });

  // Handle delete confirmation
  const handleDeleteClick = (shipment) => {
    setShipmentToDelete(shipment);
    setDeleteDialogOpen(true);
  };

  const handleConfirmDelete = async () => {
    if (!shipmentToDelete) return;
    try {
      await handleDeleteShipment(shipmentToDelete.id);
      setSnackbar({
        open: true,
        message: 'Xóa lịch vận chuyển thành công',
        severity: 'success',
      });
    } catch (error) {
      console.error('Error deleting shipment:', error);
      setSnackbar({
        open: true,
        message: 'Đã có lỗi xảy ra khi xóa lịch vận chuyển',
        severity: 'error',
      });
    } finally {
      setDeleteDialogOpen(false);
      setShipmentToDelete(null);
    }
  };

  // Handle search
  const handleSearch = (e) => {
    setSearchTerm(e.target.value);
  };

  // Filter shipments based on search term
  const filteredShipments = shipments.filter((shipment) => {
    if (!searchTerm) return true;
    const searchLower = searchTerm.toLowerCase();
    return (
      (shipment.dienGiai && shipment.dienGiai.toLowerCase().includes(searchLower)) ||
      (shipment.khachHang && shipment.khachHang.ten && shipment.khachHang.ten.toLowerCase().includes(searchLower)) ||
      (shipment.tuyenDuongDi && shipment.tuyenDuongDi.toLowerCase().includes(searchLower)) ||
      (shipment.tuyenDuongDen && shipment.tuyenDuongDen.toLowerCase().includes(searchLower)) ||
      (shipment.trangThai && shipment.trangThai.toLowerCase().includes(searchLower))
    );
  });

  // Close snackbar
  const handleCloseSnackbar = () => {
    setSnackbar((prev) => ({
      ...prev,
      open: false,
    }));
  };

  // Table columns
  const columns = [
    {
      key: 'ngayThang',
      label: 'Ngày tháng',
      render: (value) => formatDateForDisplay(value),
    },
    {
      key: 'khachHang',
      label: 'Khách hàng',
      render: (value) => (value ? value.ten : ''),
    },
    {
      key: 'tuyenDuongDi',
      label: 'Tuyến đường đi',
    },
    {
      key: 'tuyenDuongDen',
      label: 'Tuyến đường đến',
    },
    {
      key: 'trangThai',
      label: 'Trạng thái',
      render: (value) => (
        <Chip 
          label={value} 
          color={getStatusColor(value)} 
          size="small" 
        />
      ),
    },
    {
      key: 'actions',
      label: 'Thao tác',
      align: 'right',
      render: (_, record) => (
        <Box sx={{ display: 'flex', justifyContent: 'flex-end', gap: 1 }}>
          <EditButton onClick={() => handleOpenModalForEdit(record)} disabled={isLoading} />
          <DeleteButton onClick={() => handleDeleteClick(record)} disabled={isLoading} />
        </Box>
      ),
    },
  ];

  return (
    <Box sx={{ p: isMobile ? 1 : 3 }}>
      <Paper sx={{ p: 3, mb: 3 }}>
        <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 3 }}>
          <Typography variant="h5" component="h1">
            Quản lý lịch vận chuyển
          </Typography>
          <Button
            variant="contained"
            color="primary"
            startIcon={<PlusIcon />}
            onClick={handleOpenModalForAdd}
            disabled={isLoading}
          >
            Thêm mới
          </Button>
        </Box>

        <Box sx={{ mb: 3 }}>
          <TextField
            fullWidth
            variant="outlined"
            placeholder="Tìm kiếm..."
            value={searchTerm}
            onChange={handleSearch}
            InputProps={{
              startAdornment: <SearchIcon sx={{ mr: 1, color: 'text.secondary' }} />,
            }}
          />
        </Box>

        {error && (
          <Alert severity="error" sx={{ mb: 3 }}>
            {error}
          </Alert>
        )}

        {isLoading ? (
          <Box display="flex" justifyContent="center" p={3}>
            <CircularProgress />
          </Box>
        ) : (
          <StandardTable
            columns={columns}
            data={filteredShipments}
            loading={isLoading}
            emptyMessage="Không có dữ liệu lịch vận chuyển"
          />
        )}
      </Paper>

      {/* Shipment Form Modal */}
      <LichVanChuyenForm
        open={isModalOpen}
        onClose={handleCloseModal}
        formData={formData}
        onChange={handleInputChange}
        onSave={handleSaveShipment}
        isSaving={isLoading}
        error={error}
        vehicles={vehicles}
        partners={partners}
        customers={customers}
        containerTypes={containerTypes}
      />

      {/* Delete Confirmation Dialog */}
      <Dialog open={deleteDialogOpen} onClose={() => setDeleteDialogOpen(false)}>
        <DialogTitle>Xác nhận xóa</DialogTitle>
        <DialogContent>
          Bạn có chắc chắn muốn xóa lịch vận chuyển này?
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setDeleteDialogOpen(false)}>Hủy</Button>
          <Button 
            onClick={handleConfirmDelete} 
            color="error"
            disabled={isLoading}
          >
            Xóa
          </Button>
        </DialogActions>
      </Dialog>

      {/* Snackbar for notifications */}
      <Snackbar
        open={snackbar.open}
        autoHideDuration={6000}
        onClose={handleCloseSnackbar}
        anchorOrigin={{ vertical: 'top', horizontal: 'right' }}
      >
        <Alert 
          onClose={handleCloseSnackbar} 
          severity={snackbar.severity}
          sx={{ width: '100%' }}
        >
          {snackbar.message}
        </Alert>
      </Snackbar>
    </Box>
  );
};

export default QuanLyLichVanChuyen;
